@model PrimeChip.Models.DashboardViewModel

<div class="row g-3 mb-4 top-stat">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-box fs-1 text-primary"></i><div><h6 class="m-0 text-muted">Total Stock Units</h6><p class="m-0 fw-bold">@Model.TotalStock</p></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-exclamation-triangle fs-1 text-warning"></i><div><h6 class="m-0 text-muted">Low Stock Products</h6><p class="m-0 fw-bold">@Model.LowStock</p></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-exclamation-circle fs-1 text-danger"></i><div><h6 class="m-0 text-muted">Out of Stock Items</h6><p class="m-0 fw-bold">@Model.OutOfStock</p></div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-cash-coin fs-1 text-success"></i><div><h6 class="m-0 text-muted">Inventory Value</h6><p class="m-0 fw-bold">₱@Model.TotalInventoryValue.ToString("N2")</p></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-cart-dash fs-1 text-primary"></i><div><h6 class="m-0 text-muted">Units Sold Today</h6><p class="m-0 fw-bold">@Model.UnitsSoldToday</p></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-graph-up-arrow fs-1 text-success"></i><div><h6 class="m-0 text-muted">Estimated Sales Today</h6><p class="m-0 fw-bold">₱@Model.SalesValueToday.ToString("N2")</p></div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4"><div class="card-body d-flex align-items-center gap-4">
            <i class="bi bi-arrow-left-right fs-1 text-info"></i><div><h6 class="m-0 text-muted">Stock Outs Today</h6><p class="m-0 fw-bold">@Model.StockOutsToday</p></div>
        </div></div>
    </div>
</div>