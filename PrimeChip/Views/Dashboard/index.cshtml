@model PrimeChip.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
}

@section Scripts {
    <script>
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const chartQty = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartQty));
        const chartValue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValue));
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/dashboard.js"></script>
}

<div class="layout-wrapper">
    <partial name="_SideNav" />

    <!-- DASHBOARD CONTENT -->
    <div class="main flex-column bg-light">
        <partial name="_TopNav" />
        <div id="sidebar-backdrop"></div>

        <main class="p-3">

            <div class="container-fluid">

                <!-- Page Header -->
                <div class="mb-4">
                    <h1 class="fw-bold">Inventory Dashboard</h1>
                    <p class="text-muted">Live stock levels, movements, and today's sales activity.</p>
                </div>
                <!--TOP STATS-->
                <partial name="_TopStats"  view-data="ViewData"/>

            <!-- UPPER ROW  -->
            <div class="row mb-3 g-3 p-3 justify-content-evenly">

                <!-- Line Chart -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                        <h6 class="fw-semibold mb-3">Sold Units and Estimated Sales — Last 7 Months</h6>
                         <canvas id="line-chart"></canvas>
                    </div>
                </div>

                <!-- Recent Alerts -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-semibold m-0">Recent Alerts</h6>
                                <a asp-controller="Alerts" asp-action="Index" class="view-all-btn">View All</a>
                            </div>
                            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                                @if (Model.Alerts.Count == 0)
                                {
                                    <li class="text-muted">No products are at or below their reorder level.</li>
                                }
                                @foreach (var product in Model.Alerts)
                                {
                                    <li class="d-flex align-items-start gap-3 p-2 rounded-3 @(product.Stock == 0 ? "bg-danger" : "bg-warning") bg-opacity-10">
                                        <i class="bi @(product.Stock == 0 ? "bi-exclamation-circle-fill text-danger" : "bi-exclamation-triangle-fill text-warning") fs-5 mt-1 flex-shrink-0"></i>
                                        <div>
                                            <p class="mb-0 fw-semibold">@product.Name — @(product.Stock == 0 ? "Out of Stock" : "Low Stock")</p>
                                            <small class="text-muted">@product.Stock available; reorder level @product.ReorderLevel</small>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

            <!-- LOWER ROW: Purchase Orders + Top Stock Items -->
            <div class="row g-3 p-3 justify-content-evenly">

                <!-- Recent Purchase Orders -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-semibold m-0">Recent Stock Movements</h6>
                                <a asp-controller="StockOut" asp-action="Index" class="view-all-btn">View Stock Out</a>
                            </div>
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Vendor / Reason</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var movement in Model.RecentMovements)
                                    {
                                        <tr>
                                            <td><span class="badge @(movement.MovementType == "StockIn" ? "bg-success" : "bg-danger")">@movement.MovementType</span></td>
                                            <td>@movement.Category — @movement.ProductName</td>
                                            <td>@movement.Quantity</td>
                                            <td>@(movement.Vendor?.vendorName ?? movement.Reason ?? "—")</td>
                                            <td>@movement.CreatedAt.ToString("MMM dd, hh:mm tt")</td>
                                        </tr>
                                    }
                                    @if (Model.RecentMovements.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted text-center">No stock movements have been recorded.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Top Stock Items -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-semibold m-0">Largest On-Hand Balances</h6>
                                <a asp-controller="Inventory" asp-action="Index" class="view-all-btn">View Inventory</a>
                            </div>
                            <table class="table table-sm table-hover table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.TopStockItems)
                                    {
                                        <tr><td>@product.Name</td><td>@product.Stock</td><td>₱@((product.Stock * product.UnitPrice).ToString("N2"))</td></tr>
                                    }
                                    @if (Model.TopStockItems.Count == 0)
                                    {
                                        <tr><td colspan="3" class="text-muted text-center">No products available.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

          </div>

        </main>
    </div>
</div>