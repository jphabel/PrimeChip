@model PrimeChip.Models.StockInViewModel

@{
	ViewData["Title"] = "Stock In";
}

@section Styles {
	<link rel="stylesheet" href="~/css/dashboard.css" />
	<link rel="stylesheet" href="~/css/sidebar.css" />
}

<div class="layout-wrapper">
	<partial name="_SideNav" />
	<div class="main flex-column bg-light">
		<partial name="_TopNav" />
		<div id="sidebar-backdrop"></div>
		<main class="p-3">
			<div class="container-fluid">
				<div class="mb-4">
					<h1 class="fw-bold">Stock In</h1>
					<p class="text-muted">Record goods received from a vendor. Quantity is added to on-hand stock.</p>
				</div>

				@if (TempData["Success"] is string success)
				{
					<div class="alert alert-success">@success</div>
				}
				@if (!ViewData.ModelState.IsValid)
				{
					<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
				}

				<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
					<form asp-action="Create" method="post" class="row g-3">
						@Html.AntiForgeryToken()
						<div class="col-md-6">
							<label asp-for="Category" class="form-label">Category</label>
							<select asp-for="Category" class="form-select">
								<option value="">Select category</option>
								@foreach (var category in Model.Categories)
								{
									<option value="@category">@category</option>
								}
							</select>
							<span asp-validation-for="Category" class="text-danger"></span>
						</div>
						<div class="col-md-6">
							<label asp-for="ProductName" class="form-label">Product Name</label>
							<input asp-for="ProductName" class="form-control" maxlength="100" autocomplete="off" />
							<span asp-validation-for="ProductName" class="text-danger"></span>
						</div>
						<div class="col-md-6">
							<label asp-for="VendorId" class="form-label">Vendor</label>
							<select asp-for="VendorId" class="form-select">
								<option value="0">Select vendor</option>
								@foreach (var vendor in Model.Vendors)
								{
									<option value="@vendor.Id">@vendor.vendorName</option>
								}
							</select>
							<span asp-validation-for="VendorId" class="text-danger"></span>
						</div>
						<div class="col-md-3">
							<label asp-for="Quantity" class="form-label">Quantity Received</label>
							<input asp-for="Quantity" type="number" min="1" class="form-control" />
							<span asp-validation-for="Quantity" class="text-danger"></span>
						</div>
						<div class="col-md-3">
							<label asp-for="SKU" class="form-label">SKU <small>(new product)</small></label>
							<input asp-for="SKU" class="form-control" maxlength="100" />
							<span asp-validation-for="SKU" class="text-danger"></span>
						</div>
						<div class="col-md-3">
							<label asp-for="UnitPrice" class="form-label">Unit Price <small>(new product)</small></label>
							<input asp-for="UnitPrice" type="number" min="0" step="0.01" class="form-control" />
							<span asp-validation-for="UnitPrice" class="text-danger"></span>
						</div>
						<div class="col-md-3">
							<label asp-for="ReorderLevel" class="form-label">Reorder Level <small>(new product)</small></label>
							<input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
						</div>
						<div class="col-md-4">
							<label asp-for="Date" class="form-label">Date</label>
							<input asp-for="Date" type="date" class="form-control" />
						</div>
						<div class="col-md-4">
							<label asp-for="Note" class="form-label">Optional Note / Reference</label>
							<input asp-for="Note" class="form-control" maxlength="500" />
						</div>
						<div class="col-12 text-end">
							<button type="submit" class="btn btn-primary">Record Stock In</button>
						</div>
					</form>
				</div>

				<div class="card border-0 shadow-sm rounded-4 p-3">
					<h5 class="fw-semibold">Recent Stock In</h5>
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0">
							<thead class="table-light"><tr><th>Date / Time</th><th>Category</th><th>Product</th><th>SKU</th><th>Vendor</th><th>Quantity</th><th>Note</th></tr></thead>
							<tbody>
								@foreach (var movement in Model.RecentMovements)
								{
									<tr>
										<td>@movement.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
										<td>@movement.Category</td>
										<td>@movement.ProductName</td>
										<td>@movement.Inventory.SKU</td>
										<td>@movement.Vendor?.vendorName</td>
										<td>@movement.Quantity</td>
										<td>@movement.Note</td>
									</tr>
								}
								@if (Model.RecentMovements.Count == 0)
								{
									<tr><td colspan="7" class="text-center text-muted">No stock receipts recorded yet.</td></tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</main>
	</div>
</div>
