@model PrimeChip.Models.StockOutReportViewModel

@{
    ViewData["Title"] = "Stock Out & Sales Report";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <style>
        @@media print { .no-print, #sidebar, nav { display: none !important; } .main { width: 100% !important; } }
    </style>
}

<div class="layout-wrapper">
    <partial name="_SideNav" />
    <div class="main flex-column bg-light">
        <partial name="_TopNav" />
        <div id="sidebar-backdrop"></div>
        <main class="p-3">
            <div class="container-fluid">
                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="fw-bold">Stock Out &amp; Sales Report</h1>
                        <p class="text-muted">@Model.StartDate.ToString("MMM dd, yyyy") – @Model.EndDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="d-flex gap-2 no-print">
                        <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary rounded-5">Back</a>
                        <button type="button" class="btn btn-success rounded-5" onclick="window.print()"><i class="bi bi-printer-fill me-1"></i> Print</button>
                    </div>
                </div>

                <form method="get" asp-action="SalesReport" class="row g-2 align-items-end mb-4 no-print">
                    <div class="col-auto"><label for="startDate" class="form-label">From</label><input id="startDate" name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
                    <div class="col-auto"><label for="endDate" class="form-label">To</label><input id="endDate" name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
                    <div class="col-auto"><button type="submit" class="btn btn-primary">Apply Dates</button></div>
                </form>

                <div class="row g-3 mb-4">
                    <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="text-muted">Units Sold</div><div class="fs-3 fw-bold">@Model.UnitsSold</div></div></div>
                    <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="text-muted">Estimated Sales Value</div><div class="fs-3 fw-bold">₱@Model.EstimatedSalesValue.ToString("N2")</div></div></div>
                    <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4 p-3"><div class="text-muted">Stock Out Transactions</div><div class="fs-3 fw-bold">@Model.Transactions</div></div></div>
                </div>

                <div class="card border-0 shadow-sm p-3">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>DATE / TIME</th><th>CATEGORY</th><th>PRODUCT</th><th>SKU</th><th>QTY OUT</th><th>REASON</th><th>VALUE</th><th>NOTE</th></tr></thead>
                            <tbody>
                                @foreach (var movement in Model.Movements)
                                {
                                    <tr>
                                        <td>@movement.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td>@movement.Category</td>
                                        <td>@movement.ProductName</td>
                                        <td>@movement.Inventory.SKU</td>
                                        <td>@movement.Quantity</td>
                                        <td>@movement.Reason</td>
                                        <td>@(movement.Reason == "Sold" ? $"₱{(movement.Quantity * movement.UnitPrice):N2}" : "—")</td>
                                        <td>@movement.Note</td>
                                    </tr>
                                }
                                @if (Model.Movements.Count == 0)
                                {
                                    <tr><td colspan="8" class="text-center text-muted">No stock-out records for this date range.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>